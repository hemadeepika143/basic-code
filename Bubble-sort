import java.util.*;

public class main {

    public static void main (String [] arg) {

        Scanner sc = new Scanner (System.in);
        int size = sc.nextInt();
        int [] arr = new int [size];

        for (int i=0; i<size; i++) {
            arr[i] = sc.nextInt();
        }

        for (int i=0; i<arr.length; i++) {
            for (int j=0; j<arr.length; j++) {
                if (arr[j] > arr[j+1]) {

                    int t = arr[j];
                    arr[j] = arr[j+1];
                    arr[j+1] = t;
                }
            }
        }
    }
}
